# Copy to .env and keep it out of source control.
PUBLIC_HOST=www.example.com
ADMIN_HOST=admin.example.com
PUBLIC_BASE_URL=https://www.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-tunnel-token

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Session settings.
API_ADDRESS=:8080
LOG_LEVEL=info
SESSION_COOKIE_NAME=__Host-portfolio_session
CSRF_COOKIE_NAME=__Host-portfolio_csrf
SESSION_LIFETIME=12h
SESSION_IDLE_TIMEOUT=2h
TRUSTED_PROXY_MODE=cloudflare

# Explicit host-owned paths. The backup scripts use these same paths.
PORTFOLIO_DATA_ROOT=/srv/portfolio
PORTFOLIO_BACKUP_ROOT=/srv/portfolio-backups

# Optional offsite restic repository. Leave blank to use local backups only.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
